# Caddy fetches and renews the certificate on its own; there is no certbot step.
# Replace the email.
{
	email you@kiit.ac.in
}

gdgkiit.in {
	encode zstd gzip

	# The quiz — page, assets and API — is one Next process on loopback, and it
	# is mounted at /dor/quiz rather than at the root. `handle` (not
	# `handle_path`) is the point: the path must arrive at Next intact, because
	# Next's own `basePath` expects to see /dor/quiz on the request. Stripping the
	# prefix here would make every route 404 and every asset URL wrong.
	handle /dor/quiz* {
		reverse_proxy 127.0.0.1:3000
	}

	# Whatever else this domain serves. The landing page itself stays on Vercel;
	# if it is ever pointed here, this is where it goes.
	handle {
		respond "Not found" 404
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# Fonts are self-hosted by next/font, so there is no fonts.googleapis.com
		# or fonts.gstatic.com exemption here any more — everything but sign-in is
		# same-origin. WebGL needs no exemption either; three.js compiles shaders
		# from strings, not scripts.
		#
		# accounts.google.com appears three times, and all three are required by
		# the sign-in button: script-src to load gsi/client, frame-src because the
		# button and account chooser are iframes, connect-src for the token call.
		# Miss any one and the button silently never renders — there is no error,
		# it simply does not appear, which is a miserable thing to debug live.
		#
		# 'unsafe-inline' in style-src is Next's requirement, not a shortcut: it
		# inlines critical CSS and next/font's @font-face rules into <style> tags.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://accounts.google.com https://apis.google.com; img-src 'self' data: blob: https://*.googleusercontent.com; style-src 'self' 'unsafe-inline' https://accounts.google.com; font-src 'self'; connect-src 'self' https://accounts.google.com; frame-src https://accounts.google.com; frame-ancestors 'none'; base-uri 'self'"
	}
}
