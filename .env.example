# Copy to .env.local for development.
#
# Every name here is NEXT_PUBLIC_-prefixed, which means Next inlines it into the
# client bundle at build time. Changing one means rebuilding, not just
# restarting — and nothing secret may ever carry that prefix.

# Where this app is mounted. Must match the path the reverse proxy serves it at.
# Set it to an empty string to serve from a domain root.
NEXT_PUBLIC_BASE_PATH=/dor/quiz

# The landing page, which stays on Vercel. The nav's About/Events/Gallery links
# are absolute against this origin — they cannot be in-page anchors here.
NEXT_PUBLIC_SITE_URL=https://deployorredacted.vercel.app

# External registration link used by the nav's CTA.
NEXT_PUBLIC_REGISTER_URL=https://gdg.community.dev/gdg-on-campus-kiit/
