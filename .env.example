# Copy to .env.local for development. On the VPS this lives at /etc/dor-quiz/env,
# owned by root, chmod 640, and is loaded by systemd — never committed.
#
# Only NEXT_PUBLIC_-prefixed names reach the browser. Next inlines every one of
# them into the client bundle at build time, so nothing secret may ever carry
# that prefix, and changing one means rebuilding, not just restarting.

# ── Client (build time) ──────────────────────────────────────────────────────
# Where this app is mounted. Must match the path Caddy proxies and the systemd
# unit's build. Set it to an empty string to serve from a domain root.
NEXT_PUBLIC_BASE_PATH=/dor/quiz

# The landing page, which stays on Vercel. The nav's About/Events/Gallery links
# are absolute against this origin — they cannot be in-page anchors here.
NEXT_PUBLIC_SITE_URL=https://deployorredacted.vercel.app

# External registration link used by the nav's CTA.
NEXT_PUBLIC_REGISTER_URL=https://gdg.community.dev/gdg-on-campus-kiit/

# ── Server ───────────────────────────────────────────────────────────────────
# Must match POSTGRES_PASSWORD below. Host is 127.0.0.1 because the container
# publishes only to loopback.
DATABASE_URL=postgres://gdg:CHANGE_ME@127.0.0.1:5432/gdg_quiz

# Signs the run cookie. Without it anyone can hand-write a cookie naming someone
# else's run and answer on their behalf. Generate with:
#   openssl rand -hex 32
RUN_COOKIE_SECRET=CHANGE_ME

# Read by docker compose when it starts Postgres.
POSTGRES_PASSWORD=CHANGE_ME

# OAuth 2.0 Web client ID from the GCP console. Public by design — it is served
# to the browser so the sign-in button can render. There is no client secret:
# the ID-token flow does not use one.
#
# Create at: console.cloud.google.com → APIs & Services → Credentials →
#   Create credentials → OAuth client ID → Web application
# Authorised JavaScript origins must list every ORIGIN the page is served from.
# Origins are scheme + host only — the /dor/quiz path is not part of one:
#   https://gdgkiit.in        (production)
#   http://localhost:3000     (next dev)
# No redirect URIs are needed. Required — the server refuses to boot without it.
GOOGLE_CLIENT_ID=

# Comma-separated Workspace domains allowed to sign in, checked against the `hd`
# claim of the Google-signed token. Defaults to kiit.ac.in when unset — a deploy
# that forgot this would otherwise let any personal Gmail account in, and
# unlimited Gmail accounts means unlimited attempts. Empty string allows any
# Google account on purpose.
QUIZ_EMAIL_DOMAINS=kiit.ac.in

# Port Next binds. Caddy proxies /dor/quiz here.
PORT=3000

# Trust X-Forwarded-For for the client IP. Correct behind Caddy. Set to false if
# the process is ever exposed directly, or the per-IP rate limit can be forged.
TRUST_PROXY=true
