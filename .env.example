# Copy to .env.local for development. On the VPS this lives at /etc/dor-quiz/env,
# owned by root, chmod 640, and is loaded by systemd — never committed.
#
# Only NEXT_PUBLIC_-prefixed names reach the browser. Next inlines every one of
# them into the client bundle at build time, so nothing secret may ever carry
# that prefix, and changing one means rebuilding, not just restarting.

# ── Client: mount point and links (build time) ───────────────────────────────
# Where this app is mounted, and it defaults to the domain root — leave it empty
# and the quiz is at `/`, which is what you want for local development.
#
# ON THE VPS THIS MUST BE SET to the path Caddy proxies, or Next will serve from
# the root while Caddy sends it /dor/quiz/... and every request 404s:
#
#   NEXT_PUBLIC_BASE_PATH=/dor/quiz
#
# It is a BUILD-time value. Changing it means re-running `npm run build`, not
# restarting the service. The boot log prints the mount it was built with.
NEXT_PUBLIC_BASE_PATH=

# The landing page, which stays on Vercel. The nav's About/Events/Gallery links
# are absolute against this origin — they cannot be in-page anchors here.
NEXT_PUBLIC_SITE_URL=https://deployorredacted.vercel.app

# External registration link used by the nav's CTA.
NEXT_PUBLIC_REGISTER_URL=https://gdg.community.dev/gdg-on-campus-kiit/

# ── Firebase web config (build time, public by design) ───────────────────────
# Firebase console → Project settings → General → Your apps → Web app → SDK setup
# and configuration. These identify the project; they are not credentials, and
# they are visible in every Firebase web app. The browser uses them for exactly
# two things: the Google sign-in popup, and Analytics.
#
# Authentication must have the Google provider enabled, and every origin the page
# is served from must be listed under Authentication → Settings → Authorised
# domains (gdgkiit.in and localhost).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Analytics only. Leave it empty and analytics is a silent no-op; nothing else
# changes. Requires Google Analytics to be linked to the Firebase project.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ── Firebase Admin: the service account (SECRET) ─────────────────────────────
# Firebase console → Project settings → Service accounts → Generate new private
# key. This is what reads and writes Firestore, and it bypasses security rules —
# which is the point, since firestore.rules denies every client read and write and
# the API is the only door.
#
# Two accepted spellings. Either the whole JSON on one line:
#   FIREBASE_SERVICE_ACCOUNT={"project_id":"...","client_email":"...","private_key":"-----BEGIN..."}
# or the three fields separately, which is easier to keep in a systemd
# EnvironmentFile. The private key may keep its literal \n escapes.
FIREBASE_PROJECT_ID=your-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=

# ── Server ───────────────────────────────────────────────────────────────────
# Signs the session cookie (which carries the signed-in uid) and the admin cookie.
# Without it anyone could hand-write a cookie naming someone else's account, or
# claiming to be an organiser. Generate with:
#   openssl rand -hex 32
SESSION_COOKIE_SECRET=CHANGE_ME

# The one password that opens /dor/quiz/admin — the leaderboard, the CSV export,
# and the two cut buttons. Required: the server refuses to boot without it, so a
# deploy cannot accidentally serve the board unlocked. Compared in constant time
# behind a six-attempts-per-hour per-IP limit.
ADMIN_PASSWORD=CHANGE_ME

# Comma-separated email domains allowed to sign in, checked against the verified
# address on the Firebase ID token.
#
# EMPTY BY DEFAULT: any Google account may play. That is this event's decision,
# and the cost of it is worth stating — attempts are one per account, and Google
# accounts are free and unlimited, so someone determined can make more addresses.
# What still holds them back is the per-IP sign-in limit and the fact that a new
# account starts from zero on the same ten-second clock. Set a domain list here
# (e.g. kiit.ac.in) to get the hard one-attempt-per-person guarantee back.
QUIZ_EMAIL_DOMAINS=

# How many advance out of each round. Stage 1 (both sections) cuts to 150; stage 2
# cuts to 75, and those are the finalists. Both are frozen by an organiser from
# the admin board, not automatically.
STAGE1_CUTOFF=150
STAGE2_CUTOFF=75

# Port Next binds. Caddy proxies /dor/quiz here.
PORT=3000

# Trust X-Forwarded-For for the client IP. Correct behind Caddy. Set to false if
# the process is ever exposed directly, or the per-IP rate limits can be forged.
TRUST_PROXY=true
