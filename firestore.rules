rules_version = '2';

// Nothing reaches Firestore from a browser. Not a participant's own attempt, not
// their own score, not the question list.
//
// This is the deny that lets the answer key live in the same database as the
// scores. Every read and write goes through the Next.js API, which holds a
// service account (the Admin SDK bypasses these rules by design) and re-derives
// what the caller is allowed to see on every request. A rule set that let a
// signed-in user read their own documents would be the more conventional shape
// and would also hand every participant:
//
//   - the answer key, since a locked answer document records `correct`;
//   - a live leaderboard, since standings are ranked by a single sortable key;
//   - the ability to write their own score, unless every field were validated
//     here in a second, weaker copy of server/store.ts.
//
// The browser's only Firebase capability is Authentication, which is a different
// service and is not governed by this file.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
